# Database Configuration
POSTGRES_USER=scheduler_user
POSTGRES_PASSWORD=scheduler_password_secure_123
POSTGRES_DB=scheduler_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scheduler_user:scheduler_password_secure_123@db:5432/scheduler_db

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & JWT Secrets
SECRET_KEY=change_this_to_a_very_secret_key_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:5173", "http://192.168.0.5"]
